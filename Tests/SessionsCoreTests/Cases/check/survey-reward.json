{
  "description": "アンケートの文に見返り（無料）を書いた件は誤り survey.not_a_condition",
  "manifest": "reading-memory",
  "campaign_policy": {
    "max_shown_cap": 4,
    "holdout_min": 0.2
  },
  "releases": {
    "ios": [
      {
        "version": "3.3.0",
        "store_state": "released",
        "capabilities": [
          "action:submit_answer",
          "event:book_added",
          "event:survey_answered",
          "fact:is_premium",
          "fact:paywall_closed_count",
          "placement:survey"
        ]
      }
    ],
    "android": [
      {
        "version": "3.3.0",
        "store_state": "released",
        "capabilities": [
          "action:submit_answer",
          "event:book_added",
          "event:survey_answered",
          "fact:is_premium",
          "fact:paywall_closed_count",
          "placement:survey"
        ]
      }
    ]
  },
  "campaigns": [
    {
      "schema_version": 1,
      "status": "active",
      "priority": 40,
      "platforms": [
        "ios",
        "android"
      ],
      "starts_at": null,
      "ends_at": null,
      "id": "survey-why-not-premium",
      "type": "survey",
      "title": "ペイウォールを閉じた人に、次の起動以降の本を足した後で、今は買わない理由を1問だけ聞く",
      "purpose": "買わない理由の割合（値段・まだ分からない・欲しい機能が無い）を集め、ペイウォールの次の変え方を決める",
      "triggers": [
        {
          "id": "after_book_added",
          "event": "book_added",
          "where": null,
          "wait_seconds": 3
        }
      ],
      "audience": {
        "all": [
          {
            "fact": "is_premium",
            "eq": false
          },
          {
            "fact": "paywall_closed_count",
            "gte": 1
          }
        ]
      },
      "limits": {
        "max_shown": 1,
        "min_hours_between": 0,
        "after_dismiss_days": 30,
        "after_action_days": null,
        "not_after_in_launch": [
          {
            "event": "paywall_closed",
            "where": null
          }
        ]
      },
      "holdout": 0,
      "show": {
        "placement": "survey",
        "values": {
          "question": {
            "ja": "答えると1週間無料。理由は？",
            "en": "Why not Premium?"
          },
          "choice_1": {
            "ja": "値段",
            "en": "The price"
          },
          "choice_2": {
            "ja": "まだよく分からない",
            "en": "Not sure what I'd get"
          },
          "choice_3": {
            "ja": "欲しい機能が無い",
            "en": "Missing a feature I want"
          },
          "choice_4": {
            "ja": "ほか",
            "en": "Something else"
          },
          "free_text": true,
          "free_text_hint": {
            "ja": "よければ、ひとことで",
            "en": "Anything to add? (optional)"
          }
        },
        "text_key": "campaign.survey_why_not_premium"
      },
      "on_tap": {
        "action": "submit_answer",
        "args": {}
      },
      "goals": [
        {
          "event": "survey_answered",
          "where": null,
          "within_hours": 1
        }
      ]
    }
  ],
  "expect": {
    "errors": [
      "survey.not_a_condition"
    ],
    "warnings": []
  }
}
