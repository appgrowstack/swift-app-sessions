{
  "description": "review_ask の not_after_in_launch の paywall_closed に where（購入しなかった時だけ）を書くと誤り。閉じた起動では、買った人にも頼まない",
  "manifest": "gamification-app",
  "campaign_policy": {
    "max_shown_cap": 4,
    "holdout_min": 0.2
  },
  "releases": {
    "ios": [
      {
        "version": "3.3.0",
        "store_state": "released",
        "capabilities": [
          "action:request_review",
          "event:campaign_action_completed",
          "event:exchange_completed",
          "placement:review_ask"
        ]
      }
    ],
    "android": [
      {
        "version": "3.3.0",
        "store_state": "released",
        "capabilities": [
          "action:request_review",
          "event:campaign_action_completed",
          "event:exchange_completed",
          "placement:review_ask"
        ]
      }
    ]
  },
  "campaigns": [
    {
      "schema_version": 1,
      "status": "active",
      "priority": 50,
      "platforms": [
        "ios",
        "android"
      ],
      "starts_at": null,
      "ends_at": null,
      "id": "review-after-third-exchange",
      "type": "review_ask",
      "title": "3回目の交換が成立した後に、OS の評価の窓を出す",
      "purpose": "良い瞬間に頼んで、評価の件数が前の版より増えるか（ASC の週ごとの件数）",
      "triggers": [
        {
          "id": "third_exchange",
          "event": "exchange_completed",
          "where": {
            "prop": "count",
            "gte": 3
          },
          "wait_seconds": 2
        }
      ],
      "audience": {
        "all": [
          {
            "fact": "days_since_first_seen",
            "gte": 7
          },
          {
            "fact": "version_age_days",
            "gte": 3
          }
        ]
      },
      "limits": {
        "max_shown": 3,
        "max_per_app_version": 1,
        "min_hours_between": 2880,
        "after_dismiss_days": 60,
        "after_action_days": 60,
        "not_after_in_launch": [
          {
            "event": "paywall_closed",
            "where": {
              "prop": "result",
              "not_in": [
                "purchased",
                "restored"
              ]
            }
          },
          {
            "event": "tapped",
            "where": {
              "prop": "target",
              "eq": "feedback"
            }
          }
        ]
      },
      "holdout": 0,
      "show": {
        "placement": "review_ask",
        "values": {}
      },
      "on_tap": {
        "action": "request_review",
        "args": {}
      },
      "goals": [
        {
          "event": "campaign_action_completed",
          "where": {
            "prop": "action",
            "eq": "request_review"
          },
          "within_hours": 1
        }
      ]
    }
  ],
  "expect": {
    "errors": [
      "review_ask.not_after_in_launch"
    ],
    "warnings": []
  }
}
