{
  "description": "whats_new の例から text_key を外すと、ja と en 以外の言語の端末には出ないので警告 missing_locale（それだけ）",
  "manifest": "gamification-app",
  "campaign_policy": {
    "max_shown_cap": 4,
    "holdout_min": 0.2
  },
  "releases": {
    "ios": [
      {
        "version": "3.3.0",
        "store_state": "released",
        "capabilities": [
          "event:app_updated",
          "event:auto_check_enabled",
          "feature:auto_check",
          "placement:whats_new"
        ]
      }
    ],
    "android": [
      {
        "version": "3.3.0",
        "store_state": "released",
        "capabilities": [
          "event:app_updated",
          "event:auto_check_enabled",
          "feature:auto_check",
          "placement:whats_new"
        ]
      }
    ]
  },
  "campaigns": [
    {
      "schema_version": 1,
      "status": "active",
      "priority": 50,
      "platforms": [
        "ios",
        "android"
      ],
      "requires": [
        "feature:auto_check"
      ],
      "starts_at": null,
      "ends_at": null,
      "id": "whats-new-3-3-0-auto-check",
      "type": "whats_new",
      "title": "3.3.0 の最初の起動で、自動の達成を知らせる",
      "purpose": "知らせた人のうち、7日以内に自動の達成を入れた割合が holdout より上がるか",
      "triggers": [
        {
          "id": "updated",
          "event": "app_updated",
          "where": null,
          "wait_seconds": 30
        }
      ],
      "audience": null,
      "limits": {
        "max_shown": 1,
        "min_hours_between": 0,
        "after_dismiss_days": 0,
        "after_action_days": null
      },
      "holdout": 0.2,
      "show": {
        "placement": "whats_new",
        "values": {
          "headline": {
            "ja": "押さなくても、達成に",
            "en": "Done without a tap"
          },
          "body": {
            "ja": "歩数・運動・睡眠の習慣は、やった日に自動で達成になります。",
            "en": "Steps, workouts and sleep now count on their own."
          },
          "primary_label": {
            "ja": "設定する",
            "en": "Set up"
          }
        }
      },
      "on_tap": {
        "link": "https://gohobishukan.com/app/settings/auto-check/"
      },
      "goals": [
        {
          "event": "auto_check_enabled",
          "where": null,
          "within_hours": 168
        }
      ]
    }
  ],
  "expect": {
    "errors": [],
    "warnings": [
      "missing_locale"
    ]
  }
}
